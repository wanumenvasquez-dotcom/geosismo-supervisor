<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/night"
        app:title="Revisar evaluación"
        app:titleTextColor="@color/white"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/contDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/progressCarga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Decisión: solo se habilita después de haber visto todo el contenido -->
    <LinearLayout
        android:id="@+id/contDecision"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/paper_raised"
        android:padding="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/inputComentario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Comentario de auditoría (opcional)"
            android:background="@drawable/bg_campo"
            android:textColor="@color/ink"
            android:textColorHint="@color/gris_texto"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="10dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnCertificar" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="4dp"
                android:text="✅ Certificar" android:textAllCaps="false" android:textSize="11sp" android:backgroundTint="@color/verde" android:textColor="@color/white" />
            <Button android:id="@+id/btnAplazar" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="4dp"
                android:text="⏸️ Aplazar" android:textAllCaps="false" android:textSize="11sp" android:backgroundTint="@color/amarillo" android:textColor="@color/white" />
            <Button android:id="@+id/btnObjetar" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
                android:text="❌ Objetar" android:textAllCaps="false" android:textSize="11sp" android:backgroundTint="@color/rojo" android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
