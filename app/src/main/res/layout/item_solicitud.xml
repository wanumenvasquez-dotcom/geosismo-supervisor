<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/pillEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_neutro"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp" />

    <TextView
        android:id="@+id/txtAsunto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/ink"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtRemitente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/gris_texto"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/txtMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/ink"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtAdjunto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/acento"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtRespuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/verde"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/contAcciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/inputRespuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Escribe una respuesta..."
            android:background="@drawable/bg_campo"
            android:textColor="@color/ink"
            android:textColorHint="@color/gris_texto"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="10dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResponder"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Responder"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:backgroundTint="@color/acento"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnCerrar"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Cerrar sin responder"
                android:textAllCaps="false"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
